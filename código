// api/create-preference.js
// Roda como Serverless Function na Vercel (Node.js).
// Recebe o carrinho do site, cria uma "preference" no Mercado Pago
// (Checkout Pro) e devolve o link (init_point) para o cliente pagar.

export default async function handler(req, res) {
if (req.method !== 'POST') {
return res.status(405).json({ error: 'Método não permitido' });
}

const ACCESS_TOKEN = process.env.MP_ACCESS_TOKEN;
const SITE_URL = process.env.SITE_URL; // ex.: https://liora-aromas.vercel.app

if (!ACCESS_TOKEN || !SITE_URL) {
return res.status(500).json({
error: 'Configuração ausente: defina MP_ACCESS_TOKEN e SITE_URL nas variáveis de ambiente da Vercel.'
});
}

try {
const { items, payMethod, shipping, payer } = req.body || {};

if (!Array.isArray(items) || items.length === 0) {
return res.status(400).json({ error: 'Carrinho vazio' });
}
if (!payer || !payer.name || !payer.email) {
return res.status(400).json({ error: 'Nome e e-mail do cliente são obrigatórios' });
}

// Monta os itens da compra a partir do carrinho recebido do site.
// Nunca confie no preço vindo do front-end sem validar — aqui, como o
// catálogo é fixo no HTML, o valor recebido já corresponde ao preço
// exibido; em um catálogo maior, o ideal é re-consultar o preço no
// servidor a partir do id do produto.
const mpItems = items.map((i) => ({
title: String(i.name).slice(0, 250),
quantity: Math.max(1, parseInt(i.qty, 10) || 1),
unit_price: Number(i.price),
currency_id: 'BRL'
}));

// Frete como item separado (se houver custo).
if (shipping && Number(shipping.cost) > 0) {
mpItems.push({
title: 'Frete — Correios',
quantity: 1,
unit_price: Number(shipping.cost),
currency_id: 'BRL'
});
}

// Desconto de 5% para quem escolhe Pix: aplicado como um item de
// valor negativo, técnica suportada pela API de preferences.
if (payMethod === 'pix') {
const subtotal = items.reduce(
(s, i) => s + Number(i.price) * (parseInt(i.qty, 10) || 1),
0
);
const discount = Math.round(subtotal * 0.05 * 100) / 100;
if (discount > 0) {
mpItems.push({
title: 'Desconto Pix (5%)',
quantity: 1,
unit_price: -discount,
currency_id: 'BRL'
});
}
}

// Restringe os meios de pagamento oferecidos dentro do Checkout Pro
// de acordo com a opção escolhida no site. Os identificadores de
// payment_type_id do Mercado Pago são: credit_card, debit_card,
// ticket (boleto) e bank_transfer (Pix / transferência).
const allTypes = ['credit_card', 'debit_card', 'ticket', 'bank_transfer'];
let excluded = [];
let maxInstallments;

if (payMethod === 'pix') {
excluded = allTypes.filter((t) => t !== 'bank_transfer');
} else if (payMethod === 'boleto') {
excluded = allTypes.filter((t) => t !== 'ticket');
} else if (payMethod === 'card') {
excluded = allTypes.filter((t) => t !== 'credit_card' && t !== 'debit_card');
maxInstallments = 3; // até 3x sem juros, conforme anunciado no site
} else if (payMethod === 'transfer') {
excluded = allTypes.filter((t) => t !== 'bank_transfer');
}

const preference = {
items: mpItems,
payer: {
name: payer.name,
email: payer.email,
address: payer.cep
? { zip_code: payer.cep, street_number: payer.num || undefined }
: undefined
},
shipments:
shipping && shipping.method === 'correios'
? { cost: Number(shipping.cost) || 0, mode: 'not_specified' }
: undefined,
payment_methods: {
excluded_payment_types: excluded.map((id) => ({ id })),
...(maxInstallments ? { installments: maxInstallments } : {})
},
back_urls: {
success: `${SITE_URL}/?status=success`,
failure: `${SITE_URL}/?status=failure`,
pending: `${SITE_URL}/?status=pending`
},
auto_return: 'approved',
statement_descriptor: 'LIORA AROMAS',
metadata: {
cliente_endereco: payer.addr || '',
cliente_numero: payer.num || ''
}
};

const mpResponse = await fetch('https://api.mercadopago.com/checkout/preferences', {
method: 'POST',
headers: {
'Content-Type': 'application/json',
Authorization: `Bearer ${ACCESS_TOKEN}`
},
body: JSON.stringify(preference)
});

const data = await mpResponse.json();

if (!mpResponse.ok) {
console.error('Erro Mercado Pago:', data);
return res.status(mpResponse.status).json({ error: data });
}

return res.status(200).json({
id: data.id,
init_point: data.init_point // link de checkout para redirecionar o cliente
});
} catch (err) {
console.error('Erro ao criar preferência:', err);
return res.status(500).json({ error: 'Erro interno ao criar pagamento' });
}
}
